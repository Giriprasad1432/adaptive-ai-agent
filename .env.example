# Server Configuration
PORT=3000

# Primary AI Provider Configuration
# Supported providers: ollama (tries Ollama first, auto-fallbacks to Groq), groq, demo
AI_PROVIDER=ollama
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=20000

# Optional: Local Ollama Configuration (if using local offline models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# MCP (Model Context Protocol) Server Configuration
# Primary Application: StudyPilot MCP Server
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=./studypilot-server/server.js

# Agent Execution Bounds
MAX_AGENT_ROUNDS=6
MCP_TOOL_TIMEOUT_MS=20000

# Optional: Remote Streamable HTTP MCP server (for Alexa+ or remote deployment)
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# MCP_AUTH_TOKEN=your_optional_secret_token

