# Server Configuration
PORT=3000

# AI Provider Configuration
# Supported providers: ollama (Groq and others coming soon)
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# MCP (Model Context Protocol) Server Configuration
# Primary Application: StudyPilot MCP Server
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=./studypilot-server/server.js

# Optional Development Alternative: Calculator Server
# MCP_SERVER_ARGS=../mcp-server/server.js

# Agent Execution Bounds
MAX_AGENT_ROUNDS=6
MCP_TOOL_TIMEOUT_MS=20000
