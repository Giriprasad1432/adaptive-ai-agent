# Server Configuration
PORT=3000

# AI Provider Configuration
# Supported providers: ollama, groq
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Groq configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MCP (Model Context Protocol) Server Configuration
# Primary Application: StudyPilot MCP Server
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=./studypilot-server/server.js


# Agent Execution Bounds
MAX_AGENT_ROUNDS=6
MCP_TOOL_TIMEOUT_MS=20000

# Optional: use a deployed Streamable HTTP MCP server instead of stdio
# MCP_SERVER_URL=https://your-domain.example/mcp
